  "components": {
    "schemas": {
      "CreateProjectRequest": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "focus_seed": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Focus Seed"
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "CreateProjectRequest"
      },
      "DiscoverModelsRequest": {
        "properties": {
          "provider": {
            "type": "string",
            "enum": [
              "ollama",
              "vllm"
            ],
            "title": "Provider"
          },
          "base_url": {
            "type": "string",
            "title": "Base Url"
          }
        },
        "type": "object",
        "required": [
          "provider",
          "base_url"
        ],
        "title": "DiscoverModelsRequest"
      },
      "DiscoverModelsResponse": {
        "properties": {
          "models": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Models"
          }
        },
        "type": "object",
        "required": [
          "models"
        ],
        "title": "DiscoverModelsResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "capabilities": {
            "additionalProperties": {
              "type": "string",
              "enum": [
                "pending",
                "ready",
                "failed"
              ]
            },
            "propertyNames": {
              "enum": [
                "vault",
                "database",
                "docker",
                "llm",
                "search",
                "embeddings",
                "reranker",
                "voice"
              ]
            },
            "type": "object",
            "title": "Capabilities"
          }
        },
        "type": "object",
        "required": [
          "capabilities"
        ],
        "title": "HealthResponse"
      },
      "ModelSettings": {
        "properties": {
          "providers": {
            "additionalProperties": {
              "$ref": "#/components/schemas/ProviderInfo"
            },
            "type": "object",
            "title": "Providers"
          },
          "primary_model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Primary Model"
          },
          "auxiliary_model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Auxiliary Model"
          },
          "onboarding_completed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Onboarding Completed At"
          }
        },
        "type": "object",
        "required": [
          "providers"
        ],
        "title": "ModelSettings"
      },
      "Note": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "project_id": {
            "type": "string",
            "format": "uuid",
            "title": "Project Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "file_path": {
            "type": "string",
            "title": "File Path"
          },
          "body": {
            "type": "string",
            "title": "Body"
          },
          "frontmatter": {
            "additionalProperties": true,
            "type": "object",
            "title": "Frontmatter"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "project_id",
          "title",
          "file_path",
          "body",
          "frontmatter",
          "created_at",
          "updated_at"
        ],
        "title": "Note",
        "description": "The `notes` row (Schema.md), returned by every notes endpoint."
      },
      "NoteInput": {
        "properties": {
          "frontmatter_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Frontmatter Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "body": {
            "type": "string",
            "title": "Body"
          }
        },
        "type": "object",
        "required": [
          "title",
          "body"
        ],
        "title": "NoteInput",
        "description": "What a caller submits to create or update a note.\n\n`frontmatter_id` is absent to create (Vault Writer assigns one) and\npresent to update \u2014 the id carried in the note's own YAML frontmatter,\nnever the file path (D4)."
      },
      "PaperSummary": {
        "properties": {
          "canonical_id": {
            "type": "string",
            "title": "Canonical Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "abstract": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Abstract"
          },
          "authors": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Authors",
            "default": []
          },
          "year": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Year"
          },
          "venue": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Venue"
          },
          "citation_count": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Citation Count"
          },
          "source_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Url"
          },
          "pdf_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pdf Url"
          }
        },
        "type": "object",
        "required": [
          "canonical_id",
          "title"
        ],
        "title": "PaperSummary"
      },
      "ProjectResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "slug": {
            "type": "string",
            "title": "Slug"
