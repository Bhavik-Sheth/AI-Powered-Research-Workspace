# Backend dev environment — copy this file to `.env` and fill in values.
# `.env` is gitignored; never commit real secrets.
#
# This is only for running the sidecar standalone (`python main.py`,
# no Electron). In the real app the desktop shell generates BEARER_TOKEN
# fresh on every launch (D2) — it is never a fixed value there.

# Any string; must match what you pass to curl/the frontend's
# VITE_DEV_TOKEN while testing.
BEARER_TOKEN=devtoken

# Fixed port for standalone dev, so it matches frontend/.env.development.example
# out of the box. The real (Electron) app ignores this and always uses a
# fresh random port instead.
SIDECAR_DEV_PORT=41500

# Optional — only override if you changed docker/docker-compose.yml.
# POSTGRES_USER=researchos
# POSTGRES_PASSWORD=researchos
# POSTGRES_DB=researchos
# POSTGRES_PORT=5433

# Search Federation's relevance authority (Phase 6.1, D21 amendment). An
# infra key like the DB DSN above, not an LLM provider credential, so it's
# read straight from here rather than through Settings Store's encrypted
# provider-key path (D13 covers LLM providers only). Leaving this unset is
# a valid, fully-supported state: search degrades to the arXiv/OpenAlex/S2
# fan-out ranked by deterministic lexical score, and names `firecrawl` in
# `sources_failed`. Get a key at https://www.firecrawl.dev/.
# FIRECRAWL_API_KEY=

# Used only by scripts/configure_provider.py, which pastes this through
# Settings Store's normal validated-and-encrypted save path (D13) — it is
# never read directly by the app itself. Get a free key at
# https://console.groq.com/keys.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Local models via Ollama or vLLM (D11/D12) — no key needed, just a
# reachable endpoint. Uncomment and run:
#   uv run python scripts/configure_provider.py ollama
# Leave *_MODEL unset to have the script discover and pick the first
# model your local server currently has loaded.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b
# VLLM_BASE_URL=http://localhost:8000
# VLLM_MODEL=
